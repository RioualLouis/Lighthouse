{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lighthouse",
  "mainBinaryName": "lighthouse",
  "version": "1.3.0",
  "identifier": "io.github.lighthouse.uml",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run vendor",
    "beforeDevCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lighthouse",
        "width": 1360,
        "height": 840,
        "minWidth": 880,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Live Mermaid UML diagram editor",
    "longDescription": "Lighthouse lets you write class, sequence, use case, state and activity diagrams in Mermaid Markdown with a live, themed preview, and export them to Markdown or PNG.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "graphics"
      }
    },
    "publisher": "Lighthouse contributors",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
